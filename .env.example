# Copy to Vercel Environment Variables (or `.env.local` for `vercel dev`)

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Path to ledger in repo (default if unset: data/ledger.json)
# LEDGER_PATH=data/ledger.json

# Comma-separated origins allowed for CORS (e.g. your GitHub Pages URL).
# If unset, Access-Control-Allow-Origin is * (fine for quick tests; tighten for production).
# ALLOWED_ORIGINS=https://you.github.io,http://localhost:3000
